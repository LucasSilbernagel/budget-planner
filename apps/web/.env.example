# Database Configuration
# For development: Local PostgreSQL
# For production: DanubeData PostgreSQL (Germany - EU) per ADR-001
#
# Format: postgresql://user:password@host:port/database
#
# Development (local PostgreSQL):
DATABASE_URL=postgresql://budget-planner-user:CHANGE_ME_TO_YOUR_PASSWORD@localhost:5432/budget-planner-dev

# Production (DanubeData managed PostgreSQL, Falkenstein DE — story 4.17):
# The instance is reachable ONLY over DanubeData internal DNS; there is no public
# endpoint. The host must be permitted by `isEuSovereignDbHost` in
# packages/db/src/client.ts, which admits either a dot-anchored `.danubedata.ro`
# host or the internal writer name by EXACT match. Anything else throws at
# `getPool()` when NODE_ENV is not development/test.
# DATABASE_URL=postgresql://bp_app:password@budget-planner-prod-rw:5432/pgdb
#
# CA certificate (PEM) for the managed instance's TLS chain. Read directly from
# process.env by packages/db/src/client.ts — it is NOT in the Zod env schema, so
# nothing will warn you if it is missing. Outside development/test the pool always
# sets `rejectUnauthorized: true`; supply this whenever the DanubeData CA is not in
# the container's trust store, or verification fails and every query errors.
# Paste the PEM as a single value (newlines preserved) from the DanubeData console.
# DATABASE_CA_CERT=

# Application Environment
# `production` is what arms the fail-closed paths: EU host allowlist, TLS
# verification, the SESSION_SECRET length floor, and the https SITE_URL check.
# The DB tier (packages/db) reads process.env directly and treats an unset or
# unknown value as production-grade; the Zod env schema (packages/config) instead
# defaults an unset value to `development`. Set it explicitly to avoid the gap.
NODE_ENV=development

# Session signing secret (HMAC-SHA256 key for signed session cookies).
# REQUIRED in production (NODE_ENV=production): authentication fails closed if
# this is missing or shorter than 32 characters. Generate with:
#   openssl rand -hex 32
# Rotating this value invalidates all existing sessions (users must re-login).
# In development it may be omitted (an insecure fallback is used with a warning).
SESSION_SECRET=

# Optional: Separate read-only connection for queries
# DATABASE_READ_URL=postgresql://budget-planner-user:CHANGE_ME_TO_YOUR_PASSWORD@localhost:5432/budget-planner-dev

# Formspark form id for the in-app contact form (story 9-1, FR27).
# This is a PUBLIC identifier (it ships in the client bundle), not a secret —
# that is why it is VITE_-prefixed and exposed to the browser. Obtain it by
# creating a form at https://formspark.io/ (the submission endpoint is
# submit-form.com). See ADR-004 for the documented data-residency exception.
# When unset, the contact form shows "temporarily unavailable."
VITE_FORMSPARK_FORM_ID=

# counter.dev analytics site id (story 10-1, FR28).
# Cookieless, privacy-friendly, open-source (AGPL) visitor analytics. Loaded once
# from https://cdn.counter.dev/script.js as a server-rendered <script data-id>.
# This is a PUBLIC identifier (it ships in client HTML by design), not a secret —
# that is why it is VITE_-prefixed and exposed to the browser bundle. Obtain it
# by creating an account at https://counter.dev/. See ADR-005 for the documented
# data-residency exception (visitor metadata only, no financial data). When unset,
# no analytics script is loaded.
VITE_COUNTERDEV_ID=

# ── Paddle Billing (story 5-3, ADR-003) ──────────────────────────────────────
# Paddle is the UK Merchant of Record for the €39/yr and €99 lifetime plans.
# Identity is NOT Paddle — the app's own magic-link login mints the session
# (story 5-16); the Billing webhook (POST /api/webhooks/paddle) creates the user
# and sets the DB-authoritative subscriptionStatus.
#
# In production every value below is injected as a Rapids secret — nothing reads
# a .env file. Outside development, `assertPaddleProductionConfig()` throws on the
# webhook path if the API key, client token, webhook secret, or EITHER price ID
# is missing (a misdeployed build must crash, not silently earn nothing).

# sandbox | production. Selects the API base URL (sandbox-api.paddle.com vs
# api.paddle.com) and the Paddle.js environment. GET /api/paddle/checkout-config
# (the /pricing checkout's entry point) refuses to serve a default for this one
# var — it must be set explicitly, or that endpoint 500s. Uncomment the line
# below to exercise the checkout locally; leaving it commented is fine for
# everything else (webhook route, other Paddle code keeps the schema's sandbox
# default).
# PADDLE_ENVIRONMENT=sandbox

# Server-side Billing REST API key (`pdl_sdbx_...` / `pdl_live_...`). Used to
# resolve a customer's email on a webhook (GET /customers/{id}). SECRET.
PADDLE_API_KEY=

# Client-side token for Paddle.js checkout (`test_...` / `live_...`). Safe to ship
# to the browser — Paddle.js runs it in the browser bundle by design. Read by
# GET /api/paddle/checkout-config and handed to `initializePaddle()`
# (`lib/paddle/checkout.ts`).
PADDLE_CLIENT_TOKEN=

# Notification-destination secret (`pdl_ntfset_...`) — HMAC key for the
# `Paddle-Signature` header. SECRET. Captured when the webhook is registered.
PADDLE_WEBHOOK_SECRET=

# Max age (seconds) of a webhook's signed timestamp before it is rejected as a
# replay. Default 300. Paddle's SDKs use 5s; a self-hosted receiver behind clock
# skew needs a wider window.
# PADDLE_WEBHOOK_MAX_AGE_SECONDS=300

# Live Paddle price IDs for the two Premium plans (story 25-2). MUST differ.
# The webhook grants permanent 'lifetime' only for a transaction whose line item
# matches PADDLE_LIFETIME_PRICE_ID.
PADDLE_ANNUAL_PRICE_ID=
PADDLE_LIFETIME_PRICE_ID=
