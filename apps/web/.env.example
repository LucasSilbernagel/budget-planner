# Database Configuration
# For development: Local PostgreSQL
# For production: DanubeData PostgreSQL (Germany - EU) per ADR-001
#
# Format: postgresql://user:password@host:port/database
#
# Development (local PostgreSQL):
DATABASE_URL=postgresql://budget-planner-user:CHANGE_ME_TO_YOUR_PASSWORD@localhost:5432/budget-planner-dev

# Production (DanubeData PostgreSQL):
# Host must match the production allowlist in packages/db/src/client.ts
# (e.g. *.danubedata.com). A bare name like "your-db-name-rw" is rejected.
# DATABASE_URL=postgresql://user:password@your-db.danubedata.com:5432/your-db-name

# Application Environment
NODE_ENV=development

# Session signing secret (HMAC-SHA256 key for signed session cookies).
# REQUIRED in production (NODE_ENV=production): authentication fails closed if
# this is missing or shorter than 32 characters. Generate with:
#   openssl rand -hex 32
# Rotating this value invalidates all existing sessions (users must re-login).
# In development it may be omitted (an insecure fallback is used with a warning).
SESSION_SECRET=

# Optional: Separate read-only connection for queries
# DATABASE_READ_URL=postgresql://budget-planner-user:CHANGE_ME_TO_YOUR_PASSWORD@localhost:5432/budget-planner-dev
