# Database Configuration
# For development: Local PostgreSQL
# For production: DanubeData PostgreSQL (Germany - EU) per ADR-001
#
# Format: postgresql://user:password@host:port/database
#
# Development (local PostgreSQL):
DATABASE_URL=postgresql://budget-planner-user:yourpassword@localhost:5432/budget-planner-dev

# Production (DanubeData PostgreSQL):
# DATABASE_URL=postgresql://user:password@your-db-name-rw:5432/your-db-name

# Application Environment
NODE_ENV=development

# Optional: Separate read-only connection for queries
# DATABASE_READ_URL=postgresql://budget-planner-user:yourpassword@localhost:5432/budget-planner-dev
