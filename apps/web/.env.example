# Every value is optional in development; the free tier needs none.
# In production these are Rapids secrets, not a .env file. See README "Environment Variables".

NODE_ENV=development
DATABASE_URL=postgresql://budget-planner-user:CHANGE_ME@localhost:5432/budget-planner-dev
# DATABASE_CA_CERT=

# Required in production: >= 32 chars (openssl rand -hex 32). Rotating it signs everyone out.
SESSION_SECRET=
# Required in production: public https origin; magic links are built from it.
SITE_URL=http://localhost:5173

# Brevo magic-link email; required in production.
# EMAIL_API_KEY=
# EMAIL_FROM=hello@longhandbudget.com

# Public ids, shipped in the client bundle.
VITE_FORMSPARK_FORM_ID=
VITE_COUNTERDEV_ID=

# Must be set explicitly for GET /api/paddle/checkout-config; other Paddle code defaults to sandbox.
# PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# PADDLE_WEBHOOK_MAX_AGE_SECONDS=300
PADDLE_MONTHLY_PRICE_ID=
PADDLE_ANNUAL_PRICE_ID=
PADDLE_LIFETIME_PRICE_ID=

# Bearer token for POST /api/internal/retention-sweep; unset disables the endpoint.
# RETENTION_SWEEP_TOKEN=
