{
	"name": "@budget-planner/web",
	"version": "0.0.1",
	"description": "Longhand Budget web app (TanStack Start)",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build && node scripts/generate-sw.mjs && node scripts/precompress.mjs",
		"build:sw": "node scripts/generate-sw.mjs",
		"start": "node server-entry.mjs",
		"preview": "vite preview",
		"type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.vitest.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.node.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test": "vitest run --config vitest.config.ts",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"icons:generate": "node scripts/generate-icons.mjs"
	},
	"dependencies": {
		"@budget-planner/config": "workspace:*",
		"@budget-planner/core": "workspace:*",
		"@budget-planner/db": "workspace:*",
		"@paddle/paddle-js": "^1.6.4",
		"@tanstack/react-router": "^1.170.16",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.32.0",
		"markdown-to-jsx": "^9.8.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"recharts": "^2.15.3",
		"tailwind-merge": "^2.6.1",
		"zod": "^3.22.4",
		"zustand": "^4.4.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/react-start": "^1.168.26",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.19.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.1.0",
		"@vitest/coverage-v8": "^3.2.6",
		"autoprefixer": "^10.4.17",
		"jsdom": "^24.1.3",
		"msw": "^2.14.6",
		"postcss": "^8.4.35",
		"sharp": "^0.35.2",
		"tailwindcss": "^3.4.1",
		"typescript": "^5.3.3",
		"vite": "^7.3.6",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^3.2.6",
		"workbox-build": "^7.4.1",
		"workbox-cacheable-response": "7.4.1",
		"workbox-strategies": "7.4.1",
		"workbox-window": "^7.4.1"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
