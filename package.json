{
  "name": "budget-planner",
  "version": "0.0.1",
  "description": "Budget Planner - Personal finance tracking application",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "type-check": "pnpm --filter web type-check",
    "type-check:all": "pnpm -r type-check",
    "tsc": "tsc",
    "tsc:web": "pnpm --filter web tsc --noEmit",
    "tsc:core": "pnpm --filter @budget-planner/core tsc --noEmit",
    "tsc:db": "pnpm --filter @budget-planner/db tsc --noEmit",
    "tsc:config": "pnpm --filter @budget-planner/config tsc --noEmit",
    "validate:tsconfig": "node scripts/validate-tsconfig.js",
    "test": "pnpm -r run test:unit",
    "test:unit": "pnpm -r run test:unit",
    "test:watch": "pnpm -r run test:watch",
    "test:e2e": "pnpm --filter @budget-planner/web test:e2e"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
