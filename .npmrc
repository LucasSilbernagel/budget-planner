# pnpm Configuration
# Budget Planner - Monorepo with pnpm workspaces

# Use pnpm as the package manager
use-workspaces=true

# Engine compatibility
engine-strict=false

# Hoist shared dependencies to root
hoist=true

# Peer dependency rules - disabled for now to avoid issues
strict-peer-dependencies=false

# Node modules structure
node-linker=isolated
