# Dependencies
node_modules/
.pnpm-store/

# Lockfiles
pnpm-lock.yaml

# BMAD Output (generated artifacts - do not commit)
_bmad-output/

# BMAD User Configuration (personal settings - do not commit)
_bmad/config.user.toml

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Compiled artifacts accidentally emitted into package source (all source is .ts)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# TypeScript build cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Database migrations are tracked in git (Story 5-14) so the schema history is
# reproducible in CI/prod. The drizzle output dir (packages/db/migrations) is now
# versioned; only the empty runtime scratch dir under src/ stays ignored.
packages/db/src/migrations/

# OS generated files
*.pid
*.seed

# Coverage
coverage/
.nyc_output/

# Test
.coverage

# Temporary files
tmp/
temp/

# Python bytecode from .claude/hooks helpers
__pycache__/
