{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../db"
    },
    {
      "path": "../config"
    }
  ]
}
