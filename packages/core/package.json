{
	"name": "@budget-planner/core",
	"version": "0.0.1",
	"description": "Longhand Budget: Shared TypeScript utilities and calculation engine",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc",
		"type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"test:unit": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@budget-planner/db": "workspace:*",
		"@vitest/coverage-v8": "^5.0.3",
		"typescript": "^5.3.3",
		"@biomejs/biome": "2.5.15",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
