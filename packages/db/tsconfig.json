{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Override for library package */
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    
    /* Module */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    
    /* Type checking */
    "composite": true,
    "declaration": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
