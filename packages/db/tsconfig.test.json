{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"noEmit": true,
		"rootDir": ".",
		"declaration": false,
		"declarationMap": false,
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": false
	},
	"include": ["src/**/*", "*.ts", "scripts/**/*"],
	"exclude": ["node_modules", "dist"]
}
