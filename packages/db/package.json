{
  "name": "@budget-planner/db",
  "version": "0.0.1",
  "description": "Budget Planner - Database schema and ORM (Drizzle ORM)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'DB dev script (to be configured)'",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --apply",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "drizzle-kit": "^0.20.17",
    "dotenv": "^16.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "biome": "^0.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "pnpm": {}
}
